# ---------------------------------------------------------------------------
# Teams Voice Migration Factory - environment template
# Copy to .env and adjust. NEVER commit a real .env.
# ---------------------------------------------------------------------------

# --- Postgres -------------------------------------------------------------
POSTGRES_USER=tvmf
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=tvmf
# Connection string used by api + worker + migrator (inside docker network)
DATABASE_URL=postgres://tvmf:change-me-postgres@postgres:5432/tvmf

# --- Redis (job queue for the deployment engine) ------------------------
REDIS_URL=redis://redis:6379

# --- API ---------------------------------------------------------------
API_PORT=4000
# 32+ random bytes, base64. Used to sign access tokens.
JWT_ACCESS_SECRET=change-me-access-secret-32-bytes-min
JWT_REFRESH_SECRET=change-me-refresh-secret-32-bytes-min
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000
# AES-256-GCM key (base64, 32 bytes) - encrypts short-lived items at rest
# (e.g. queued job payloads). Customer tenant tokens are NEVER written here.
DATA_ENCRYPTION_KEY=change-me-base64-32-byte-key
# Public origin of the web app, for the CORS allow-list. Behind a reverse proxy
# the SPA and /api are same-origin, so set this to the public HTTPS URL.
#   local dev:   http://localhost:5173
#   production:  https://www.voxshift.io
WEB_ORIGIN=http://localhost:5173
# Leave EMPTY for a host-only cookie (binds to whatever host served the page -
# correct behind the proxy). Only set it (e.g. voxshift.io) if the app
# is served from more than one sub-domain of the same site.
COOKIE_DOMAIN=
# MUST be true once the site is served over HTTPS (adds the Secure flag to the
# refresh cookie). Keep false only for plain-HTTP local dev.
COOKIE_SECURE=false

# --- TOTP / MFA -------------------------------------------------------
TOTP_ISSUER=Teams Voice Migration Factory

# --- Email (SMTP relay) ----------------------------------------------
# The worker sends invitations and notifications. Leave SMTP_HOST EMPTY to
# disable delivery - the worker then just logs each message (including the
# invitation's temporary password) to its container log, and the admin can copy
# the password from the Users screen instead.
#
# Office 365 (SMTP AUTH client submission): host smtp.office365.com, port 587,
# SMTP_SECURE=false (STARTTLS). SMTP_USER must be a licensed mailbox with
# "Authenticated SMTP" enabled, and SMTP_PASS an app password if that account
# has MFA. The From address (MAIL_FROM) must be that mailbox or one it can
# "Send As".
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
# true only for an implicit-TLS port (usually 465); 587 uses STARTTLS -> false
SMTP_SECURE=false
SMTP_USER=no-reply@voxshift.io
SMTP_PASS=
# Sender identity used for every message the platform sends.
MAIL_FROM=no-reply@voxshift.io
MAIL_FROM_NAME=Teams Voice Migration Factory

# --- Bootstrap super admin (created by `npm run seed`) --------------
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-password

# --- Customer tenant connection (Microsoft) ------------------------------
# The Entra app registration used ONLY to start the delegated device-code
# sign-in that an engineer completes live. It has no client secret and no
# customer credentials are stored. Multi-tenant public client.
MS_DEVICECODE_CLIENT_ID=00000000-0000-0000-0000-000000000000
MS_GRAPH_SCOPES=https://graph.microsoft.com/.default offline_access

# --- Web (build-time) --------------------------------------------------
VITE_API_BASE_URL=http://localhost:4000
