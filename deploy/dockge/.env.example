# Dockge stack .env  — paste real values into Dockge's ".env" editor.
# This file is a template; never commit real secrets (the repo is public).

# Postgres
POSTGRES_USER=tvmf
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=tvmf
DATABASE_URL=postgres://tvmf:CHANGE_ME@postgres:5432/tvmf

# Redis
REDIS_URL=redis://redis:6379

# API
API_PORT=4000
JWT_ACCESS_SECRET=CHANGE_ME_48_BYTES_BASE64
JWT_REFRESH_SECRET=CHANGE_ME_48_BYTES_BASE64
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000
DATA_ENCRYPTION_KEY=CHANGE_ME_32_BYTES_BASE64
# The URL you browse the app on. Bare IP is fine on a LAN.
WEB_ORIGIN=http://192.168.200.148:5173
# Leave COOKIE_DOMAIN empty when reaching the app by bare IP (host-only cookie).
COOKIE_DOMAIN=
COOKIE_SECURE=false
TOTP_ISSUER=Teams Voice Migration Factory

# First super admin — created/updated on every API start (idempotent).
BOOTSTRAP_ADMIN_EMAIL=craig@craig-may.com
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME

# Entra public client used only to start the live device-code sign-in for a
# customer tenant. No secret, no stored customer credentials.
MS_DEVICECODE_CLIENT_ID=00000000-0000-0000-0000-000000000000
MS_GRAPH_SCOPES=https://graph.microsoft.com/.default offline_access
